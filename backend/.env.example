# Copie este arquivo para .env e preencha com os valores locais.
# .env nunca deve ser commitado (ver .gitignore).

# String de conexão do PostgreSQL local (Docker, ver README).
DATABASE_URL=postgresql://pokemon:pokemon@localhost:5432/pokemon_rpg

# Origens permitidas pelo CORS, separadas por vírgula.
# Em desenvolvimento: o servidor do Vite.
# Em produção (Railway): o domínio do Cloudflare Workers do frontend.
CORS_ORIGINS=http://localhost:5173

# development | production
ENVIRONMENT=development
